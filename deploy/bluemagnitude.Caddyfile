bluemagnitude.imogrow.pt {
	encode zstd gzip
	root * /srv

	# nada do repositório é servido
	@hidden path /docs/* /src/* /.git/* /_* /.*
	handle @hidden {
		respond 404
	}

	handle /_next/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@media path *.mp4 *.webm *.webp *.jpg *.jpeg *.png *.svg *.ico
	header @media Cache-Control "public, max-age=2592000"

	@doc not path /_next/* *.mp4 *.webm *.webp *.jpg *.jpeg *.png *.svg *.ico
	header @doc Cache-Control "no-cache"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	handle {
		try_files {path} {path}/ {path}.html /404.html
		file_server
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
